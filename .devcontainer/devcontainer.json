{
  "name": "Habitly",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "forwardPorts": [4000, 5173, 5432],
  "portsAttributes": {
    "4000": { "label": "Habitly API", "onAutoForward": "notify" },
    "5173": { "label": "Habitly Web", "onAutoForward": "openPreview" }
  },
  "customizations": { "vscode": { "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss", "Prisma.prisma"] } }
}
